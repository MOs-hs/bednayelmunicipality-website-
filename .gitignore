# Environment files — NEVER commit these (contain secrets & DB credentials)
.env
.env.*
*.env
server/.env
server/.env.*
client/.env
client/.env.*
!.env.example
!server/.env.example
!client/.env.example

# Dependencies
node_modules/
server/node_modules/
client/node_modules/

# Build output
client/dist/
client/build/

# Uploaded files (user content — should not be in version control)
server/uploads/**
!server/uploads/
!server/uploads/**/
!server/uploads/**/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
*.swp
*.swo
